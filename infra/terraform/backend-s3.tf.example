# Remote state for shared/team/prod use (activated at P6.5). Local state is fine
# for solo plan/validate; switch to S3 before the first real apply so state is
# durable + lockable.
#
# Bootstrap ONCE (chicken-and-egg: the backend can't store its own creation):
#   aws s3api create-bucket --bucket voyantra-tfstate-<account-id> --region us-east-1
#   aws s3api put-bucket-versioning --bucket voyantra-tfstate-<account-id> \
#       --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name voyantra-tflock \
#       --attribute-definitions AttributeName=LockID,AttributeType=S \
#       --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
#
# Then rename this file to backend.tf and run:  terraform init -migrate-state
terraform {
  backend "s3" {
    bucket         = "voyantra-tfstate-CHANGEME"
    key            = "voyantra/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "voyantra-tflock"
    encrypt        = true
  }
}
