# ============================================================================
#  VOYANTRA - AI Travel Planner - environment TEMPLATE
# ============================================================================
#
#  Copy to `.env` and fill in. `.env` is GITIGNORED - never commit real secrets.
#  Only OPENAI_API_KEY is REQUIRED; everything else has a safe default.
#
#      cp .env.example .env
#
#  Layout rules:
#    1. One boxed section per SERVICE - everything that service needs is together.
#    2. Each section reads TITLE -> DOCUMENTATION -> VALUES. All the prose for a
#       section is stated ONCE, up front, indexed by variable name, so the
#       assignments below it are a clean block you can scan.
#    3. NEVER a trailing comment. `PORT=3001  # note` is parsed differently by
#       python-dotenv, docker compose, and a shell `source` - and on a
#       length-validated secret (LANGFUSE_ENCRYPTION_KEY) a leaked comment is a
#       boot failure. Comments go on their own line, above the values.
#
#  Host ports are grouped by STARTUP ORDER: data 3001-3003 + 3015, app 3004-3006,
#  observability 3007-3018. Only HOST ports are remapped - container ports stay
#  standard, which is why an in-network URL says `postgres:5432` while a host URL
#  says `localhost:3001`.
#
#  See every URL:   make urls
# ============================================================================


# ##########################################################################
# ##  PORTS                                                               ##
# ##########################################################################
#  Published host ports, sequenced by the order the tiers start in. A port number
#  therefore tells you which tier it belongs to.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | DATA TIER - the app's own stores                                         |
# | starts 1st                                                               |
# +--------------------------------------------------------------------------+
#  POSTGRES_PORT
#      Host port. The container always listens on 5432.
#
#  REDIS_PORT
#      Host port. The container always listens on 6379.
#
#  QDRANT_PORT
#      Vector store REST + dashboard. The container listens on 6333.
#
#  OVERPASS_PORT
#      Self-hosted Overpass/OSM API. Added after the others, so it took a HIGH
#      number rather than renumbering the observability ports below.
# --------------------------------------------------------------------------
POSTGRES_PORT=3001
REDIS_PORT=3002
QDRANT_PORT=3003
OVERPASS_PORT=3015

# +--------------------------------------------------------------------------+
# | APP TIER - api, worker, web                                              |
# | starts 2nd                                                               |
# +--------------------------------------------------------------------------+
#  API_PORT
#      FastAPI backend. Starts before web.
#
#  WORKER_METRICS_PORT
#      Celery worker's Prometheus exporter (in-network). Keep in sync with
#      infra/observability/prometheus.yml or the scrape target goes stale.
#
#  WEB_PORT
#      Next.js frontend. Last to start.
# --------------------------------------------------------------------------
API_PORT=3004
WORKER_METRICS_PORT=3005
WEB_PORT=3006

# +--------------------------------------------------------------------------+
# | OBSERVABILITY TIER - dashboards and collectors                           |
# | starts 3rd                                                               |
# +--------------------------------------------------------------------------+
#  JAEGER_UI_PORT
#      Distributed trace UI. Answers WHERE THE TIME WENT across the span tree.
#
#  OTLP_HTTP_PORT
#      OTLP/HTTP receiver. The app exports spans here.
#
#  PROMETHEUS_PORT
#      Metrics + alert rules. No auth locally.
#
#  GRAFANA_PORT
#      Dashboards. Anonymous Viewer - no login needed locally.
#
#  FLOWER_PORT
#      Celery task/queue UI.
#
#  REDISINSIGHT_PORT
#      Redis GUI. Register hosts with the GUI_* reference values further down.
#
#  LANGFUSE_PORT
#      LLM-native trace UI. Answers WHAT THE MODEL SAW AND WHAT IT COST -
#      complementary to Jaeger, not a duplicate of it.
#
#  MINIO_CONSOLE_PORT
#      MinIO web console (Langfuse's blob store).
#
#  LANGFUSE_POSTGRES_PORT
#      pgAdmin target for Langfuse's OWN metadata DB. Published high because
#      5433 is often already taken by a native Postgres install.
#
#  LOKI_PORT
#      Log aggregation. Query it in Grafana > Explore > Loki.
#      MUST be set: compose falls back to `${LOKI_PORT:-3100}`, which lands
#      outside the documented 30xx scheme.
#
#  ALERTMANAGER_PORT
#      Routes the alerts.yaml SLO/cost rules.
#      Same story as LOKI_PORT: the compose fallback is 9093.
# --------------------------------------------------------------------------
JAEGER_UI_PORT=3007
OTLP_HTTP_PORT=3008
PROMETHEUS_PORT=3009
GRAFANA_PORT=3010
FLOWER_PORT=3011
REDISINSIGHT_PORT=3012
LANGFUSE_PORT=3013
MINIO_CONSOLE_PORT=3014
LANGFUSE_POSTGRES_PORT=3016
LOKI_PORT=3017
ALERTMANAGER_PORT=3018

# +--------------------------------------------------------------------------+
# | INFERENCE TIER - self-hosted engines                                     |
# | starts last (opt-in)                                                     |
# +--------------------------------------------------------------------------+
#  VLLM_PORT
#      Host port; the container listens on 8000.
#
#  SGLANG_PORT
#      Host port; the container listens on 30000.
#
#  OPEN_WEBUI_PORT
#      ChatGPT-style UI wired straight at the engine. The UNGUARDED path: no
#      retrieval, no POI grounding, no itinerary schema. It answers "is the engine
#      generating sensible text", which curl cannot.
# --------------------------------------------------------------------------
VLLM_PORT=3019
SGLANG_PORT=3020
OPEN_WEBUI_PORT=3021


# ##########################################################################
# ##  CREDENTIALS                                                         ##
# ##########################################################################
#  Secrets and accounts. Fill these in your own `.env`; leave this template's
#  secret values EMPTY so a copy of it can never leak a real key.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | LLM PROVIDERS (D4) - OpenAI primary, the rest are fallback rungs         |
# +--------------------------------------------------------------------------+
#  OPENAI_API_KEY
#      SECRET. REQUIRED - the app fails fast at startup without it, because
#      OpenAI is the primary rung of every tier's routing chain.
#
#  ANTHROPIC_API_KEY
#      SECRET, optional. Empty = the anthropic rung is SKIPPED, never a runtime
#      401. Set it to put claude-opus-4-8 on the FRONTIER tier (planner + critic).
#
#  GROQ_API_KEY
#      SECRET, optional. Empty = the groq rung is SKIPPED.
#
#  VOYAGE_API_KEY
#      SECRET, optional embeddings (voyage-3, 1024-d).
#      LEAVE EMPTY to use OpenAI embeddings everywhere. This must MATCH how the
#      index was built: `make seed` builds with OpenAI, so the worker must query
#      with OpenAI too - the same vector space. Set this key without re-seeding
#      and retrieval silently returns nothing: no error, no warning, zero
#      grounding. To switch to Voyage: set the key AND re-seed without the
#      OpenAI override.
# --------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# +--------------------------------------------------------------------------+
# | APP POSTGRES - credentials                                               |
# +--------------------------------------------------------------------------+
#  POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#      Local dev values. DATABASE_URL (under APPLICATION) is built from these -
#      change one and you must change the URL to match.
# --------------------------------------------------------------------------
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp
POSTGRES_DB=tp

# +--------------------------------------------------------------------------+
# | WEB SESSION + DEV LOGIN - native sign-up path                            |
# +--------------------------------------------------------------------------+
#  DEV_LOGIN_PASSWORD
#      Password for the dev login when Auth0 is unset. Printed by `make urls`.
#
#  SESSION_SECRET
#      SECRET. Signs the session cookie. Use a 32-byte random string. A
#      random-per-boot value would invalidate every session on restart AND on
#      every added replica, so it must be pinned - not generated at startup.
# --------------------------------------------------------------------------
DEV_LOGIN_PASSWORD=voyantra
SESSION_SECRET=change-me-to-a-32-byte-random-string

# +--------------------------------------------------------------------------+
# | AUTH0 (D9) - optional hosted login                                       |
# +--------------------------------------------------------------------------+
#  AUTH0_DOMAIN / AUTH0_AUDIENCE / AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET / AUTH0_SECRET
#      SECRETS. The web app uses its OWN native sign-up (name, email, password,
#      plus the optional Google button) whenever this block is EMPTY. Fill the
#      whole block to switch to Auth0's hosted login.
#      The backend gate is separate: see AUTH_ENABLED under APPLICATION.
# --------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# +--------------------------------------------------------------------------+
# | GOOGLE OAUTH - optional "Continue with Google" button                    |
# +--------------------------------------------------------------------------+
#  GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#      SECRETS. Create an OAuth 2.0 Client (type: Web application) in Google
#      Cloud Console and register the redirect URI:
#          http://localhost:3006/api/auth/google/callback
#      The button auto-hides until BOTH are set; email/password works without it.
#      The redirect is built from APP_BASE_URL, so those two must agree.
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# +--------------------------------------------------------------------------+
# | LANGFUSE - API keys                                                      |
# +--------------------------------------------------------------------------+
#  LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY
#      The app exports generations with these, AND the self-hosted stack is
#      BOOTSTRAPPED with the same pair (see the INIT block below). That is what
#      makes tracing work with no manual project setup or key copying.
#      Blank them and tracing silently stops while every container stays healthy.
#      The placeholders below are valid to start with - replace for real use.
# --------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000

# +--------------------------------------------------------------------------+
# | LANGFUSE SELF-HOST STACK - its own Postgres, ClickHouse, MinIO, Redis    |
# +--------------------------------------------------------------------------+
#  LANGFUSE_INIT_USER_EMAIL / _PASSWORD / _ORG_ID / _PROJECT_ID
#      HEADLESS BOOTSTRAP. Langfuse creates the org, project and user and PINS
#      the API keys above on FIRST boot of an EMPTY database. A warm start
#      IGNORES these, so changing a key needs the Langfuse volumes wiped
#      (`make downv`) before it takes effect.
#
#  LANGFUSE_NEXTAUTH_SECRET / LANGFUSE_SALT
#      SECRETS. Change for anything beyond a local machine.
#
#  LANGFUSE_ENCRYPTION_KEY
#      SECRET. Langfuse v3 requires EXACTLY 64 hex chars (32 bytes) - which is
#      why this line must never carry a trailing comment.
#      Generate: openssl rand -hex 32
#
#  LANGFUSE_POSTGRES_* / LANGFUSE_REDIS_PASSWORD / CLICKHOUSE_* / MINIO_ROOT_*
#      SECRETS (local dev values). Langfuse state is SPLIT across all of these:
#      Postgres holds the org/project/keys, ClickHouse the spans, MinIO the raw
#      payloads. Wiping one alone re-bootstraps into a fresh project while the
#      others still hold traces pointing at the old one - which is why `make
#      downv` wipes all three together.
# --------------------------------------------------------------------------
LANGFUSE_INIT_USER_EMAIL=admin@voyantra.local
LANGFUSE_INIT_USER_PASSWORD=voyantra-admin
LANGFUSE_INIT_ORG_ID=voyantra
LANGFUSE_INIT_PROJECT_ID=voyantra
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_REDIS_PASSWORD=langfuse-redis
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret


# ##########################################################################
# ##  APPLICATION                                                         ##
# ##########################################################################
#  Runtime behaviour: which environment, which stores, which limits.
#
#  Native dev and compose differ on HOSTNAMES, not on settings: values here point
#  at localhost + published ports, and the compose files override them to the
#  in-network service names. That is why DATABASE_URL says `localhost:3001` while
#  the container runs with `@db:5432`.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | RUNTIME - process-wide behaviour                                         |
# +--------------------------------------------------------------------------+
#  APP_ENV
#      local | dev | staging | prod. Also decides whether auth is enforced when
#      AUTH_ENABLED is left unset - see AUTH_ENABLED below.
#
#  LOG_LEVEL
#      DEBUG | INFO | WARNING | ERROR. Logs are structured JSON on stdout, so
#      Loki/Docker collect them without a file path to configure.
# --------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# +--------------------------------------------------------------------------+
# | VECTOR STORE (D2) - Qdrant                                               |
# +--------------------------------------------------------------------------+
#  QDRANT_URL
#      EMPTY = native dev uses the EMBEDDED local store (.qdrant_local).
#      Compose sets http://qdrant:6333. Keep the empty value BARE - a trailing
#      comment on an empty var leaks straight into the value under compose.
# --------------------------------------------------------------------------
QDRANT_URL=

# +--------------------------------------------------------------------------+
# | GLOBAL POI TIER - self-hosted Overpass / OpenStreetMap                   |
# +--------------------------------------------------------------------------+
#  OVERPASS_URL
#      EMPTY = skip OSM and use the keyless Wikipedia fallback (native dev).
#      Compose sets the in-network URL for the worker.
#      The curated Qdrant corpus grounds hero cities; Overpass covers EVERY city
#      in the imported region with real OSM categories (temple/museum/beach/
#      restaurant/...), which is what makes interest filtering work beyond the
#      curated set.
#
#  OSM_DATA_DIR
#      Host directory holding a PRE-DOWNLOADED Geofabrik extract.
#
#  OVERPASS_PLANET_FILE
#      Filename inside OSM_DATA_DIR to import.
#      FIRST BOOT imports it into a ~40-60GB DB and takes 2-4 HOURS. Download the
#      extract yourself with a resumable curl - the container's own downloader has
#      no resume and stalls on any drop over ~11GB:
#        curl -L -C - --retry 999 --retry-delay 5 --retry-all-errors \
#          -o "./osm-data/us-latest.osm.pbf" \
#          https://download.geofabrik.de/north-america/us-latest.osm.pbf
#      To cover a different region: download that extract into OSM_DATA_DIR, set
#      this filename, and recreate the tp_overpass_db volume
#      (`make downv-overpass`).
# --------------------------------------------------------------------------
OVERPASS_URL=
OSM_DATA_DIR=./osm-data
OVERPASS_PLANET_FILE=us-latest.osm.pbf

# +--------------------------------------------------------------------------+
# | PERSISTENCE + DISPATCH (D1, D11) - Postgres and Redis                    |
# +--------------------------------------------------------------------------+
#  DATABASE_URL
#      What the app actually connects with. Native dev points at localhost;
#      compose overrides to @db:5432. Credentials come from the POSTGRES_* block
#      in CREDENTIALS - keep the two in step.
#
#  REDIS_URL
#      Celery broker + result backend, response/embedding cache, and SSE pub-sub.
#      One Redis serves all three roles deliberately (D10/D11).
# --------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tp:tp@localhost:3001/tp
REDIS_URL=redis://localhost:3002/0

# +--------------------------------------------------------------------------+
# | COST CONTROLS (D20)                                                      |
# +--------------------------------------------------------------------------+
#  MAX_COST_USD
#      Per-itinerary hard cap AND the eval budget gate. A run that would exceed
#      this is stopped rather than allowed to finish expensively - and the eval
#      harness fails the build if the measured cost per itinerary crosses it.
#
#  LLM_ENABLED
#      A FLOOR, not a toggle. Shipped false, NO runtime value can turn generation
#      back on: the Redis switch `planning:enabled` can only ever DISABLE. An
#      operator's deliberate decision has to outrank a flag someone set at 3am and
#      forgot, otherwise "we turned it off" is not a statement you can rely on.
#      Read from the environment rather than validated Settings on purpose - a cost
#      control that stops working when a provider key is missing fails in exactly
#      the situation you reached for it.
#
#  DAILY_SPEND_LIMIT_USD
#      Rolling per-DAY ceiling across every run; at 100% the service refuses new
#      runs. MAX_COST_USD above caps ONE itinerary and therefore cannot answer
#      "how much of this month went to the paid leg because the GPU was down",
#      which is the question a serving chain exists to make answerable. 0 = off,
#      which is the shipped default: adding a breaker must not start refusing
#      traffic on a deployment that never asked for one.
#
#  SPEND_SOFT_ALERT_RATIO
#      Fraction of the daily limit that raises a warning before the breaker bites.
# --------------------------------------------------------------------------
MAX_COST_USD=0.30
LLM_ENABLED=true
DAILY_SPEND_LIMIT_USD=0
SPEND_SOFT_ALERT_RATIO=0.8

# +--------------------------------------------------------------------------+
# | AUTH + ABUSE DEFENSE (D9, D20)                                           |
# +--------------------------------------------------------------------------+
#  AUTH_ENABLED
#      Backend API gate. false = open, which is what the native web session flow
#      uses locally. Set true only with the AUTH0_* block filled in.
#      UNSET = enforced everywhere except APP_ENV=local, so a default that works
#      on a laptop can never quietly reach production.
#
#  APP_BASE_URL
#      Browser-visible base URL. Used to build the Google OAuth redirect and the
#      Auth0 callback, so it must match what is registered with those providers.
#
#  RATE_LIMIT_PER_MIN
#      Per-tenant requests per minute. 0 disables. A 429 here is enforcement
#      working, not an outage.
#
#  RATE_LIMIT_PER_DAY
#      Per-tenant requests per DAY. A per-minute limit bounds burst; it does
#      nothing about a caller who sits just under it all day, so this is the
#      actual budget. 0 = off.
#
#  RATE_LIMIT_IP_PER_MIN
#      Per-IP requests per minute. A per-tenant limit alone is DEFEATED by minting
#      tenants: rotate the session cookie and the allowance multiplies by however
#      many cookies the caller cares to mint. The cost is over-counting users
#      behind shared NAT, so both scopes are checked and the strictest wins.
#      0 = off. Only trustworthy if TRUSTED_PROXY_HOPS is right.
#
#  TRUSTED_PROXY_HOPS
#      How many proxy hops to trust in X-Forwarded-For. 0 = trust NONE and use the
#      socket peer, ignoring the header entirely.
#      SET THIS WRONG AND THE PER-IP LIMIT IS DEFEATED BY ONE LINE OF CURL, while
#      still looking enforced on the dashboard. A header you trust but nobody sets
#      is a header anyone can forge, which is why 0 is the default and why the
#      client is read from the RIGHT of the list (each proxy APPENDS what it saw;
#      counting from the left takes whatever the caller typed).
# --------------------------------------------------------------------------
AUTH_ENABLED=false
APP_BASE_URL=http://localhost:3006
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=0
RATE_LIMIT_IP_PER_MIN=0
TRUSTED_PROXY_HOPS=0

# +--------------------------------------------------------------------------+
# | RETRIEVAL DEPTH (D3) - recall vs latency                                 |
# +--------------------------------------------------------------------------+
#  RETRIEVAL_TOP_K
#      Candidates fetched from Qdrant BEFORE reranking. Higher = better recall,
#      more rerank work. Was hardcoded at 20 in tp_retrieval; this is that value.
#
#  RERANK_TOP_K
#      POIs kept after reranking, i.e. what the itinerary is actually built from.
#      Was hardcoded at 8. An EXPLICIT argument at a call site still wins over
#      both of these - they only supply the default.
# --------------------------------------------------------------------------
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# +--------------------------------------------------------------------------+
# | CACHE INVALIDATION - version keys, never a manual purge                  |
# +--------------------------------------------------------------------------+
#  PROMPT_VERSION
#      Bump when a prompt changes.
#
#  CORPUS_VERSION
#      Bump after a re-ingest.
#
#  INDEX_VERSION
#      Bump after an embedding-model change.
#
#      All three compose into a prefix on EVERY cache key. Bumping one orphans the
#      old entries and lets their own TTL reap them. The alternative is FLUSHDB,
#      which is indiscriminate: a one-line prompt edit would also discard the
#      geocode, POI and route entries it did not invalidate, buying a full cold
#      cache for a change that touched none of them.
# --------------------------------------------------------------------------
PROMPT_VERSION=v1
CORPUS_VERSION=v1
INDEX_VERSION=v1

# +--------------------------------------------------------------------------+
# | INFRA CIRCUIT BREAKERS - separate from the serving-venue breaker         |
# +--------------------------------------------------------------------------+
#  POSTGRES_CIRCUIT_FAILURE_THRESHOLD
#      Consecutive failures before the leg opens. Losing Postgres DEGRADES the
#      service (history off) rather than stopping it, so this breaker exists to
#      stop hammering a dead database, not to fail requests.
#      NOTE: the settings and breaker exist; the Postgres degrade path is NOT yet
#      wired into runs.py. Documented here rather than left as a silent gap.
#
#  POSTGRES_CIRCUIT_COOLDOWN_SECONDS
#      Then exactly ONE probe is admitted.
#
#  REDIS_CIRCUIT_FAILURE_THRESHOLD
#      Redis loss is fail-OPEN: bypass the cache and keep answering. The breaker is
#      about LATENCY, not correctness - without it a dead Redis costs every request
#      its 0.25s connect timeout, turning a broken cache into added latency on 100%
#      of traffic. WIRED into tp_core/cache.py.
#
#  REDIS_CIRCUIT_COOLDOWN_SECONDS
#      Then exactly ONE probe is admitted.
# --------------------------------------------------------------------------
POSTGRES_CIRCUIT_FAILURE_THRESHOLD=3
POSTGRES_CIRCUIT_COOLDOWN_SECONDS=30
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_COOLDOWN_SECONDS=30


# ##########################################################################
# ##  OBSERVABILITY                                                       ##
# ##########################################################################
#  Where traces and metrics go. Keys live in CREDENTIALS; this section is only
#  the connection targets.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | OTEL - trace/metrics export target                                       |
# +--------------------------------------------------------------------------+
#  OTEL_EXPORTER_OTLP_ENDPOINT
#      EMPTY = native dev creates spans and simply does not export them.
#      The observability overlay sets this to the in-network collector
#      automatically, so this value is for host-run api/worker only.
# --------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# +--------------------------------------------------------------------------+
# | LANGFUSE - connection target                                             |
# +--------------------------------------------------------------------------+
#  LANGFUSE_HOST
#      Native dev talks to the self-hosted UI on LANGFUSE_PORT. Compose overrides
#      this to http://langfuse-web:3000.
# --------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3013


# ##########################################################################
# ##  LOCAL INFERENCE (self-hosted GPU)                                   ##
# ##########################################################################
#  Who generates the answer, and in what order the venues are tried.
#
#  SERVING_CHAIN is the whole failover policy in one line. It ends at a PAID leg
#  on purpose: openai is the venue that will still answer when everything free is
#  down, so ordering it last means you only spend once the alternatives have
#  actually failed. The moment it starts serving, cost stops reading $0 - and that
#  transition is how you learn a local engine died, long before anyone reports a
#  slow app.
#
#  START-UP: `make sglang-up` (engine only) or `make up-sglang` (whole app on it).
#  The Makefile's ENGINE variable sets the chain per-invocation and EXPORTS it, so
#  the value the target prints is the value the container runs.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | SERVING CHAIN - ordered failover preference                              |
# | first reachable leg answers                                              |
# +--------------------------------------------------------------------------+
#  SERVING_CHAIN
#      EMPTY = legacy behaviour (the hardcoded per-tier order in
#      tp_core/llm/models.py, OpenAI first). Setting it takes over completely, so
#      local inference is OPT-IN and an existing deployment does not change until
#      you choose. `make up-sglang` sets it for that run without editing anything.
#
#      An ORDERED PREFERENCE LIST, tried left to right. A leg whose URL or key is
#      missing is SKIPPED with a warning naming it, never a silent downgrade.
#
#        Entry form:  venue  |  venue-engine
#        Venues:      local (your GPU)  ·  groq, openai, anthropic (hosted)
#        Engines:     vllm, sglang      (the local venue only)
#
#        local-sglang,groq,openai   free local first, then cheap hosted, then paid
#        local-vllm,groq,openai     vLLM instead of SGLang
#        groq,openai                hosted only (no GPU needed)
#
#      `sglang` ALONE IS NOT VALID - it is an ENGINE, not a venue, and writing it
#      bare is rejected at startup with a message naming the fix. Engines exist
#      only on the local venue: write `local-sglang`.
#
#      ONE ENGINE AT A TIME. Listing both local legs is accepted but pointless:
#      two engines on one 12GB card is a deadlock (0.80 + 0.70 = 150% of the
#      card), and they are not independent failure domains anyway - both die with
#      the GPU. Independence begins at the hosted legs.
#
#  SERVING_ENGINE
#      Which engine a bare `local` entry resolves to. Ignored by hosted venues:
#      there is no engine of ours to choose. Kept in step with the Makefile's
#      ENGINE default, because this is what applies when the stack starts WITHOUT
#      make (a bare `docker compose up`, or a container restart).
#
#  CIRCUIT_FAILURE_THRESHOLD
#      Consecutive transient failures before a leg is SKIPPED. Without a breaker a
#      dead local engine is retried on every request, so one free leg being down
#      becomes added latency on 100% of traffic. A 4xx does NOT count - that is
#      our bad request and fails identically everywhere.
#
#  CIRCUIT_COOLDOWN_SECONDS
#      How long a tripped leg stays skipped. After it elapses exactly ONE probe is
#      admitted; success closes the breaker, failure re-opens it.
# --------------------------------------------------------------------------
SERVING_CHAIN=
SERVING_ENGINE=sglang
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# +--------------------------------------------------------------------------+
# | vLLM - self-hosted engine                                                |
# | http://localhost:3019/v1                                                 |
# +--------------------------------------------------------------------------+
#  VLLM_URL
#      EMPTY = the local-vllm leg is SKIPPED. Set it to enable that leg.
#      From the HOST use localhost; the api CONTAINER must use the service name
#      (http://vllm:8000/v1) - localhost inside a container is that container, so
#      pointing the app at localhost leaves the whole GPU half of the chain dead
#      while looking perfectly configured.
#
#  VLLM_MODEL
#      A local engine serves exactly ONE model - whichever was loaded at startup.
#      This value is BOTH the engine's --model argument AND the name the app puts
#      in every request, so changing it means restarting both sides. Asking for a
#      model the engine has not loaded returns 404, the leg fails, and you quietly
#      pay a hosted venue while believing you are self-hosting.
#      AWQ INT4 fits a 12GB card; FP16 of the same 7B does not.
#
#  VLLM_GPU_MEMORY_UTILIZATION
#      Fraction of FREE VRAM vLLM fits inside. NOT the same knob as SGLang's.
#
#  VLLM_MAX_MODEL_LEN
#      Context length. Trades directly against KV-cache size.
# --------------------------------------------------------------------------
VLLM_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=8192

# +--------------------------------------------------------------------------+
# | SGLang - self-hosted engine (DEFAULT)                                    |
# | http://localhost:3020/v1                                                 |
# +--------------------------------------------------------------------------+
#  SGLANG_URL
#      EMPTY = the local-sglang leg is SKIPPED. In-container: http://sglang:30000/v1
#
#  SGLANG_MODEL
#      Same weights as vLLM on purpose - ONE download, ONE cache volume. Keeping
#      both engines on the same model is what makes a failover comparison mean
#      anything; different weights would compare models, not engines.
#
#  SGLANG_MEM_FRACTION
#      NOT interchangeable with vLLM's flag, and copying 0.80 here OOM-kills it:
#          vLLM   --gpu-memory-utilization  measures FREE memory, fits inside it
#          SGLang --mem-fraction-static     is a fraction of TOTAL, ignoring
#                                           whatever is already resident
#      On a desktop GPU the browser and editor hold ~1.2GB and fluctuate, so 0.80
#      of 12GB leaves nothing and SGLang dies with `CUDA error: out of memory` -
#      a crash that arrives late, after it has served happily, the moment someone
#      opens another browser tab. 0.70 leaves headroom and still fits an 8k KV
#      cache alongside ~5.5GB of AWQ weights. Raise it only on a headless box.
#
#  SGLANG_MAX_MODEL_LEN
#      Context length.
# --------------------------------------------------------------------------
SGLANG_URL=http://sglang:30000/v1
SGLANG_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
SGLANG_MEM_FRACTION=0.70
SGLANG_MAX_MODEL_LEN=8192

# +--------------------------------------------------------------------------+
# | HUGGING FACE - model weight downloads                                    |
# +--------------------------------------------------------------------------+
#  HF_TOKEN
#      SECRET, optional. Required only for GATED repos; Qwen2.5-7B-Instruct-AWQ
#      is NOT gated, so the default setup needs nothing here. Unauthenticated Hub
#      pulls are throttled hard, and huggingface_hub does NOT resume across
#      process restarts - so a slow pull must still be ONE uninterrupted run.
# --------------------------------------------------------------------------
HF_TOKEN=

# ##########################################################################
# ##  LOCAL KUBERNETES (kind)  -  P6.2                                    ##
# ##########################################################################
#  Shape of the local cluster that `make infra` (and `make up`) creates.
#
#  These are rendered into infra/kind/kind-config.yaml by scripts/kind-up.sh with
#  envsubst. Changing them does NOT resize a RUNNING cluster: kind cannot
#  hot-resize its node count, so run `make infra-down` and then `make infra`.
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | KIND CLUSTER + HELM RELEASE                                              |
# +--------------------------------------------------------------------------+
#  KIND_CLUSTER_NAME
#      Cluster name; also the kubeconfig context suffix.
#
#  KIND_WORKER_COUNT
#      Number of WORKER nodes. The control-plane is separate and always 1.
#
#  KIND_NODE_IMAGE
#      PINNED to 1.31.x deliberately: a cgroup v1 host rejects kubelet 1.32+, and
#      the failure appears as nodes that never reach Ready rather than as a
#      version error.
#
#  KIND_API_REPLICAS / KIND_WORKER_REPLICAS / KIND_WEB_REPLICAS
#      Helm release replica counts (infra/helm/voyantra values). Local kind has no
#      autoscaling, so these simply set how many pods of each Deployment come up.
# --------------------------------------------------------------------------
KIND_CLUSTER_NAME=voyantra
KIND_WORKER_COUNT=3
KIND_NODE_IMAGE=kindest/node:v1.31.2
KIND_API_REPLICAS=1
KIND_WORKER_REPLICAS=1
KIND_WEB_REPLICAS=1


# ##########################################################################
# ##  GUI CLIENT REFERENCE                                                ##
# ##########################################################################
#  REFERENCE ONLY - not read by the app. These record how to point a GUI client
#  at the running stores, because the answer differs by where the client runs:
#    - from INSIDE a container (RedisInsight): use the SERVICE NAME, never localhost
#    - from the HOST (pgAdmin): use localhost + the published port
# --------------------------------------------------------------------------

# +--------------------------------------------------------------------------+
# | REDISINSIGHT -> "Add Redis database"                                     |
# +--------------------------------------------------------------------------+
#  GUI_APP_REDIS_HOST / GUI_APP_REDIS_PORT
#      The app's cache/broker. No username, no password.
#
#  GUI_LANGFUSE_REDIS_HOST / GUI_LANGFUSE_REDIS_PORT
#      Langfuse's own Redis. Password = LANGFUSE_REDIS_PASSWORD.
# --------------------------------------------------------------------------
GUI_APP_REDIS_HOST=redis
GUI_APP_REDIS_PORT=6379
GUI_LANGFUSE_REDIS_HOST=langfuse-redis
GUI_LANGFUSE_REDIS_PORT=6379

# +--------------------------------------------------------------------------+
# | PGADMIN -> Langfuse METADATA db                                          |
# +--------------------------------------------------------------------------+
#  LANGFUSE_POSTGRES_HOST
#      Service name for in-network clients. From the HOST use
#      localhost:LANGFUSE_POSTGRES_PORT instead.
#      Traces live in ClickHouse, NOT here - this DB only holds the org, project
#      and API keys.
# --------------------------------------------------------------------------
LANGFUSE_POSTGRES_HOST=langfuse-postgres
