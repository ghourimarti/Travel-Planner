# ╔══════════════════════════════════════════════════════════════════╗
# ║  Voyantra — environment template. Copy to `.env` and fill in.       ║
# ║  `.env` is gitignored — never commit real secrets. Only              ║
# ║  OPENAI_API_KEY is REQUIRED; everything else has a safe default.    ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# NOTE: keep empty vars BARE (no trailing `# comment`) — under docker compose an
# inline comment on an empty value leaks into the value. Comments go on their own line.

# ══════════════════════════════════════════════════════════════════
#   PORTS
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# data tier — the app's own stores (startup order)
# ──────────────────────────────────────────────
POSTGRES_PORT=3001              # 1. Postgres (container is always 5432 internally)
REDIS_PORT=3002                 # 2. Redis (container is always 6379 internally)
QDRANT_PORT=3003                # 3. Qdrant vector store
OVERPASS_PORT=3015              # 4. Overpass OSM API — added later, kept a high
                                 #    number to avoid reassigning the observability ports below

# ──────────────────────────────────────────────
# app tier
# ──────────────────────────────────────────────
API_PORT=3004                   # FastAPI backend (runs before web)
WORKER_METRICS_PORT=3005        # worker Prometheus exporter (in-network; keep in
                                 #   sync with infra/observability/prometheus.yml)
WEB_PORT=3006                   # Next.js frontend (last to start)

# ──────────────────────────────────────────────
# observability tier (make obs / infra)
# ──────────────────────────────────────────────
JAEGER_UI_PORT=3007             # Jaeger trace UI
OTLP_HTTP_PORT=3008             # OTLP/HTTP receiver (app exports spans here)
PROMETHEUS_PORT=3009            # Prometheus UI
GRAFANA_PORT=3010               # Grafana UI
FLOWER_PORT=3011                # Flower (Celery) UI
REDISINSIGHT_PORT=3012          # RedisInsight UI
LANGFUSE_PORT=3013              # Langfuse UI
MINIO_CONSOLE_PORT=3014         # MinIO web console (Langfuse's blob store)
LANGFUSE_POSTGRES_PORT=3016     # pgAdmin target for Langfuse's own metadata DB
LOKI_PORT=3017                  # Loki (log aggregation) — query in Grafana > Explore > Loki
ALERTMANAGER_PORT=3018          # Alertmanager (routes the alerts.yaml SLO/cost rules)

# ══════════════════════════════════════════════════════════════════
#   CREDENTIALS
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# LLM providers (OpenAI primary; others optional fallback rungs)
# ──────────────────────────────────────────────
# REQUIRED — app fails fast at startup if missing
OPENAI_API_KEY=
# optional fallback (inert if empty)
ANTHROPIC_API_KEY=
# optional fallback (inert if empty)
GROQ_API_KEY=
# optional embeddings (voyage-3, 1024-d). Leave EMPTY to use OpenAI embeddings everywhere
# (must match `make seed`, which builds the index with OpenAI — else RAG silently returns nothing).
VOYAGE_API_KEY=

# ──────────────────────────────────────────────
# app Postgres  (DATABASE_URL is under APP CONFIG — update it if you change these)
# ──────────────────────────────────────────────
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp
POSTGRES_DB=tp

# ──────────────────────────────────────────────
# Web app session + dev login  (native sign-up; see APP CONFIG for the Auth0 toggle)
# ──────────────────────────────────────────────
DEV_LOGIN_PASSWORD=voyantra
SESSION_SECRET=change-me-to-a-32-byte-random-string

# ──────────────────────────────────────────────
# Auth0 (OPTIONAL) — leave EMPTY to use the native sign-up above.
# ──────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ──────────────────────────────────────────────
# "Continue with Google" (OPTIONAL) — Google Cloud OAuth 2.0 Web client.
# Register redirect URI  http://localhost:3006/api/auth/google/callback . Button hides until both are set.
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Langfuse (LLM-native trace UI) — these keys double as the self-host INIT keys
# below, so a fresh self-host stack already accepts them.
# ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000

# ──────────────────────────────────────────────
# Langfuse SELF-HOST stack (in docker-compose.observability.yml)
# ──────────────────────────────────────────────
LANGFUSE_INIT_USER_EMAIL=admin@voyantra.local
LANGFUSE_INIT_USER_PASSWORD=voyantra-admin
LANGFUSE_INIT_ORG_ID=voyantra
LANGFUSE_INIT_PROJECT_ID=voyantra
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef  # 256-bit hex
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_REDIS_PASSWORD=langfuse-redis
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# ══════════════════════════════════════════════════════════════════
#   APP CONFIG
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=local                  # local | dev | staging | prod
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ──────────────────────────────────────────────
# Embeddings / Vector store (Qdrant)
# ──────────────────────────────────────────────
# native dev: empty → embedded; compose sets http://qdrant:6333 (keep bare — empty var)
QDRANT_URL=

# ──────────────────────────────────────────────
# Global POI tier — self-hosted Overpass / OpenStreetMap
# ──────────────────────────────────────────────
# The curated Qdrant corpus grounds hero cities; Overpass covers EVERY city in the
# imported region with real OSM categories (temple/museum/beach/restaurant/…), so
# interest filtering works globally-within-region. Without it, the app degrades to
# corpus + a keyless Wikipedia fallback.
#
# native dev: empty → skip OSM, use Wikipedia fallback. compose sets the in-network URL.
OVERPASS_URL=
# Overpass imports a PRE-DOWNLOADED local extract on FIRST BOOT (~2-4h import into
# ~40-60GB DB) — the container's own downloader has no resume and stalls on any drop
# over ~11GB. Download a Geofabrik extract with a resumable curl into OSM_DATA_DIR:
#   curl -L -C - --retry 999 --retry-delay 5 --retry-all-errors \
#     -o "./osm-data/us-latest.osm.pbf" \
#     https://download.geofabrik.de/north-america/us-latest.osm.pbf
# To cover a different region, download that Geofabrik extract into OSM_DATA_DIR, set
# OVERPASS_PLANET_FILE to its filename, and recreate the tp_overpass_db volume.
OSM_DATA_DIR=./osm-data
OVERPASS_PLANET_FILE=us-latest.osm.pbf

# ──────────────────────────────────────────────
# Persistence (Postgres) — connection string (credentials are above)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tp:tp@localhost:3001/tp

# ──────────────────────────────────────────────
# Async dispatch + cache (Redis)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:3002/0

# ──────────────────────────────────────────────
# Cost controls
# ──────────────────────────────────────────────
MAX_COST_USD=0.30

# ──────────────────────────────────────────────
# Sign-in mode
#   Native sign-up (First/Last name, email, password + optional Google) is used
#   whenever the AUTH0_* block (above, in CREDENTIALS) is EMPTY. Fill it in to
#   switch to Auth0's hosted login.
# ──────────────────────────────────────────────
AUTH_ENABLED=false             # backend API gate: false → open (native web sessions)
APP_BASE_URL=http://localhost:3006   # browser-visible base URL (builds the Google redirect)
RATE_LIMIT_PER_MIN=60

# ──────────────────────────────────────────────
# Observability — trace/metrics export target
# ──────────────────────────────────────────────
# native dev only; observability overlay sets this in-network (keep bare — empty var)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ──────────────────────────────────────────────
# Langfuse — connection (keys are above, in CREDENTIALS)
# ──────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3013

# ──────────────────────────────────────────────
# P6.2 local Kubernetes (kind) — `make infra` / part of `make up`
#   Rendered into infra/kind/kind-config.yaml by scripts/kind-up.sh (envsubst).
#   Changing these does NOT resize a running cluster — run `make infra-down`
#   then `make infra` (or `make up`) to recreate it with the new shape.
# ──────────────────────────────────────────────
KIND_CLUSTER_NAME=voyantra
KIND_WORKER_COUNT=3            # number of worker nodes (control-plane is separate, always 1)
KIND_NODE_IMAGE=kindest/node:v1.31.2   # pinned to 1.31.x — this host's cgroup v1 rejects kubelet 1.32+
# Helm release replica counts (infra/helm/voyantra values). Local kind has no
# autoscaling — these just set how many pods of each Deployment come up.
KIND_API_REPLICAS=1
KIND_WORKER_REPLICAS=1
KIND_WEB_REPLICAS=1

# ---- GUI client connection reference (RedisInsight / pgAdmin) -----------------
# Reference only — NOT read by the app. Every container shares the compose network.
# From INSIDE a container use the SERVICE NAME (never localhost); from the HOST use
# localhost + published port.
#
# RedisInsight -> "Add Redis database":
#     App Redis       Host=redis           Port=6379   no username, no password
#     Langfuse Redis  Host=langfuse-redis  Port=6379   password = LANGFUSE_REDIS_PASSWORD
GUI_APP_REDIS_HOST=redis
GUI_APP_REDIS_PORT=6379
GUI_LANGFUSE_REDIS_HOST=langfuse-redis
GUI_LANGFUSE_REDIS_PORT=6379
#
# pgAdmin -> Langfuse METADATA db (traces live in ClickHouse, not here).
# Host port is a variable because 5433 is often taken by a native Postgres install.
LANGFUSE_POSTGRES_HOST=langfuse-postgres
