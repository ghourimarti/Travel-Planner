/demo
demo
Docss/

# P6.2 local Helm secret overrides — never commit real keys
values-secret.yaml
infra/helm/**/values-secret.yaml

# P6.2 kind config rendered from kind-config.yaml.tpl by scripts/kind-up.sh
infra/kind/kind-config.yaml

# Terraform (P6.3): local state, plans, vars, provider cache
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
infra/terraform/terraform.tfvars
# NOTE: .terraform.lock.hcl is intentionally committed (pins provider hashes).

