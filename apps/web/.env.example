# ----------------------------------------------------------------------------
# Voyantra web (apps/web) — copy to .env.local and fill in.
# The app runs KEYLESS for local dev: with none of these set and the FastAPI
# backend in dev mode (AUTH_REQUIRED=false), you get the full trace UI without
# an Auth0 tenant. Set the Auth0 block to turn real login on.
# ----------------------------------------------------------------------------

# Where the FastAPI backend lives (server-side only; the browser never sees it).
BACKEND_API_URL=http://localhost:8000

# --- Dev login (active when the Auth0 block below is empty) ------------------
# The app is ALWAYS gated. Without Auth0, sign in at /login with any email and
# this shared password. Sessions are signed with SESSION_SECRET.
DEV_LOGIN_PASSWORD=voyantra
SESSION_SECRET=change-me-to-a-long-random-string

# --- Auth0 (optional for local dev; required for real login) ----------------
# Create a "Regular Web Application" in Auth0 and an API (audience) for the backend.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# AUTH0_SECRET=use `openssl rand -hex 32` to generate a 32-byte value
# APP_BASE_URL=http://localhost:3000
# AUTH0_AUDIENCE=https://api.voyantra.app   # must match the backend's AUTH0_AUDIENCE
# AUTH0_SCOPE=openid profile email offline_access
