# ╔══════════════════════════════════════════════════════════════════╗
# ║  Voyantra — environment template. Copy to `.env` and fill in.       ║
# ║  `.env` is gitignored — never commit real secrets. Only              ║
# ║  OPENAI_API_KEY is REQUIRED; everything else has a safe default.    ║
# ╚══════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=local                 # local | dev | staging | prod
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ──────────────────────────────────────────────
# LLM providers (Decision 4 — OpenAI primary; others optional fallback rungs)
#   NOTE: keep empty vars BARE (no trailing `# comment`) — under docker compose an
#   inline comment on an empty value leaks into the value. Comments go on their own line.
# ──────────────────────────────────────────────
# REQUIRED — app fails fast at startup if missing
OPENAI_API_KEY=
# optional fallback (inert if empty)
ANTHROPIC_API_KEY=
# optional fallback (inert if empty)
GROQ_API_KEY=
# optional embeddings (voyage-3, 1024-d). Leave EMPTY to use OpenAI embeddings everywhere
# (must match `make seed`, which builds the index with OpenAI — else RAG silently returns nothing).
VOYAGE_API_KEY=

# ──────────────────────────────────────────────
# Embeddings / Vector store (Qdrant)
# ──────────────────────────────────────────────
# native dev: empty → embedded; compose sets http://qdrant:6333 (keep bare — empty var)
QDRANT_URL=
QDRANT_PORT=3003              # data tier, 3rd store

# ──────────────────────────────────────────────
# POI search (Overpass — self-hosted, OSM tag-accurate restaurants/shops/bars/etc.)
#   Public Overpass mirrors WAF-block or hang from most networks, so a self-hosted
#   instance is the only reliable source. OPTIONAL: leave OVERPASS_URL bare for
#   native dev (falls back to the Wikipedia classifier, which can't see
#   restaurants/shops — see tp_tools/pois.py); compose sets it automatically.
#   First container start imports OVERPASS_PLANET_URL (default: Asia extract,
#   ~2-4h one-time) into a volume; later starts reuse it and start in seconds.
# ──────────────────────────────────────────────
OVERPASS_URL=
OVERPASS_PORT=3015             # data tier, 4th store
OVERPASS_PLANET_URL=https://download.geofabrik.de/asia-latest.osm.pbf

# ──────────────────────────────────────────────
# Persistence (Postgres)
# ──────────────────────────────────────────────
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp
POSTGRES_DB=tp
POSTGRES_PORT=3001            # data tier, 1st store (container is always 5432 internally)
DATABASE_URL=postgresql+asyncpg://tp:tp@localhost:3001/tp

# ──────────────────────────────────────────────
# Async dispatch + cache (Redis)
# ──────────────────────────────────────────────
REDIS_PORT=3002              # data tier, 2nd store (container is always 6379 internally)
REDIS_URL=redis://localhost:3002/0

# ──────────────────────────────────────────────
# Cost controls
# ──────────────────────────────────────────────
MAX_COST_USD=0.30

# ──────────────────────────────────────────────
# Sign-in mode
#   Native sign-up (First/Last name, email, password + optional Google) is used
#   whenever the AUTH0_* block is EMPTY. Fill AUTH0_* to switch to Auth0's hosted login.
# ──────────────────────────────────────────────
AUTH_ENABLED=false            # backend API gate: false → open (native web sessions)
APP_BASE_URL=http://localhost:3006   # browser-visible base URL (builds the Google redirect)
RATE_LIMIT_PER_MIN=60

# Auth0 (OPTIONAL) — leave empty to use the native sign-up.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# "Continue with Google" (OPTIONAL) — Google Cloud OAuth 2.0 Web client.
# Register redirect URI  http://localhost:3006/api/auth/google/callback . Button hides until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Web app (Next.js)
# ──────────────────────────────────────────────
API_PORT=3004                 # app tier, backend (runs before web)
WEB_PORT=3006                 # app tier, frontend (last to start)
DEV_LOGIN_PASSWORD=voyantra
SESSION_SECRET=change-me-to-a-32-byte-random-string

# ──────────────────────────────────────────────
# Observability — dashboard host ports
# ──────────────────────────────────────────────
WORKER_METRICS_PORT=3005      # in-network; keep in sync with infra/observability/prometheus.yml
JAEGER_UI_PORT=3007
OTLP_HTTP_PORT=3008
PROMETHEUS_PORT=3009
GRAFANA_PORT=3010
FLOWER_PORT=3011
REDISINSIGHT_PORT=3012
# native dev only; observability overlay sets this in-network (keep bare — empty var)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ──────────────────────────────────────────────
# Langfuse (LLM-native trace UI)
# ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000
LANGFUSE_HOST=http://localhost:3013
LANGFUSE_PORT=3013            # observability tier

# ──────────────────────────────────────────────
# Langfuse SELF-HOST stack (in docker-compose.observability.yml)
# ──────────────────────────────────────────────
LANGFUSE_INIT_USER_EMAIL=admin@voyantra.local
LANGFUSE_INIT_USER_PASSWORD=voyantra-admin
LANGFUSE_INIT_ORG_ID=voyantra
LANGFUSE_INIT_PROJECT_ID=voyantra
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef  # 256-bit hex
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_REDIS_PASSWORD=langfuse-redis
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_CONSOLE_PORT=3014       # observability tier
