# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- App ---
APP_ENV=local            # local | dev | staging | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- LLM providers ---
# Required now (primary provider — app fails fast at startup if missing):
OPENAI_API_KEY=

# Optional fallback rungs (used only if set):
ANTHROPIC_API_KEY=       # fallback tier
GROQ_API_KEY=            # fallback tier
VOYAGE_API_KEY=          # S6 — embeddings

# --- Persistence / async dispatch (S9) ---
# Omit for a zero-Docker sqlite default; for the worker path use compose Postgres + Redis:
DATABASE_URL=postgresql+asyncpg://tp:tp@localhost:5432/tp
REDIS_URL=redis://localhost:6379/0
